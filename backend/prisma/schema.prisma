generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PedidoStatus {
  aberto
  em_andamento
  concluido
}

enum PedidoPrioridade {
  baixa
  media
  alta
}

model Pedido {
  id        String           @id @default(cuid())
  titulo    String
  descricao String
  status    PedidoStatus     @default(aberto)
  prioridade PedidoPrioridade 
  data_criacao DateTime         @default(now())

  comentarios Comentario[]
}

model Comentario{
  id        String           @id @default(cuid())
  pedidoId  String
  autor     String
  mensagem  String
  data DateTime         @default(now())

  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([pedidoId])
}